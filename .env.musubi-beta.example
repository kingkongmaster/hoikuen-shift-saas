# Values only. Copy this template to the root-owned VPS environment file and never commit it.
AEN_SHIFT_DOMAIN=
ACME_EMAIL=
AEN_SHIFT_API_IMAGE=
AEN_SHIFT_WEB_IMAGE=
AEN_SHIFT_MIGRATION_IMAGE=
AEN_SHIFT_OPERATIONS_IMAGE=
AEN_SHIFT_BACKUP_IMAGE=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD_FILE=
BACKUP_PGUSER=
BACKUP_PGPASS_FILE=
MUSUBI_ROSTER_DIRECTORY=/opt/aen-shift/roster
BACKUP_RETENTION_COUNT=7
# aen_app only; never use a schema owner for API runtime
DATABASE_URL=
# aen_migrator only; supplied exclusively to migration process
MIGRATION_DATABASE_URL=
# aen_app for data-only operations
OPERATIONS_DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOG_LEVEL=log
READINESS_DB_TIMEOUT_MS=3000
DATABASE_TARGET_ID=
CONFIRM_DATABASE_TARGET_ID=
ALLOW_PRODUCTION_MIGRATION=false
ALLOW_PRODUCTION_PROVISIONING=false
