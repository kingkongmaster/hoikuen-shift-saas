# Install only after /etc/aen-shift/backup.env and its PGPASSFILE are mode 600.
# This repository does not install or modify crontab automatically.
CRON_TZ=Asia/Tokyo
17 2 * * * aenshift docker compose --env-file /opt/aen-shift/.env -f /opt/aen-shift/current/compose.musubi-beta.yaml --profile operations run --rm backup
