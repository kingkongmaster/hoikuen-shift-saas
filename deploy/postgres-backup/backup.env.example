# Install the real file outside Git as /etc/aen-shift/backup.env with mode 600.
# Do not place a password or DATABASE_URL in this version-controlled example.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=aenshift_backup
PGDATABASE=aenshift_production
PGPASSFILE=/etc/aen-shift/pgpass
BACKUP_ENVIRONMENT=production
BACKUP_DIRECTORY=/var/backups/aen-shift/postgresql
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_AGE_SECONDS=93600
OFFHOST_COPY_ENABLED=false
BACKUP_ENCRYPTION_RECIPIENT=
OFFHOST_UPLOAD_ADAPTER=
NOTIFICATION_ADAPTER=
