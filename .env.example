# PostgreSQL
POSTGRES_DB=enshift
POSTGRES_USER=enshift
POSTGRES_PASSWORD=change-me-in-production
# Docker Compose専用。実値はGit管理しない.envだけに設定します。
COMPOSE_POSTGRES_PASSWORD=use-a-separate-strong-local-secret
POSTGRES_PORT=5432

# NestJS
NODE_ENV=development
DEPLOYMENT_ENV=development
API_PORT=3000
# ホスト実行専用。Docker Compose内では使用せず、docker-compose.ymlがpostgres向けURLを組み立てます。
DATABASE_URL=postgresql://enshift:change-me-in-production@localhost:5432/enshift
DATABASE_CONNECT_ON_STARTUP=true
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRES_IN=8h
WEB_ORIGIN=http://localhost:8080
TRUST_PROXY=0
LOG_LEVEL=log
READINESS_DB_TIMEOUT_MS=3000
SEED_OWNER_EMAIL=owner@demo.enshift.local
DEMO_USER_PASSWORD=ChangeMe123!
# 通常起動ではseedされません。明示実行時だけ有効化します。
SEED_DEMO_DATA=false

# React / Vite (browser-visible values must never contain secrets)
VITE_API_BASE_URL=/api
API_UPSTREAM=http://api:3000
